# Copy to .env and fill in. .env is git-ignored: NEVER commit it.

# ---- AWS ---------------------------------------------------------------
AWS_REGION=us-east-1
# profile holding taxi-pipeline-user's access key
AWS_PROFILE=taxi-pipeline
# must be globally unique, lowercase
S3_BUCKET=yourname-nyc-taxi-lake-2025

# ---- Data period ---------------------------------------------------------
TRIP_YEAR=2025
TRIP_MONTH=1

# ---- Catalog: polaris (preferred) or glue (fallback) ---------------------
CATALOG_TYPE=polaris
ICEBERG_NAMESPACE=nyc_taxi

# ---- Polaris (local Docker) ------------------------------------------------
POLARIS_URI=http://localhost:8181/api/catalog
POLARIS_CATALOG=taxi_catalog
POLARIS_ROOT_CLIENT_ID=root
POLARIS_ROOT_CLIENT_SECRET=change-me-local-only
# client_id:client_secret used by Spark
POLARIS_CREDENTIAL=root:change-me-local-only
POLARIS_STORAGE_ROLE_ARN=arn:aws:iam::123456789012:role/taxi-polaris-storage-role
# Access key of taxi-polaris-service-user (can only assume the role above)
POLARIS_AWS_ACCESS_KEY_ID=
POLARIS_AWS_SECRET_ACCESS_KEY=

# ---- Spark -----------------------------------------------------------------
SPARK_MASTER=local[*]
SPARK_DRIVER_MEMORY=4g
