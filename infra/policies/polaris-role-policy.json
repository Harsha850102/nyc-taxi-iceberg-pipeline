{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListWarehouse",
      "Effect": "Allow",
      "Action": ["s3:ListBucket", "s3:GetBucketLocation"],
      "Resource": "arn:aws:s3:::${S3_BUCKET}",
      "Condition": {"StringLike": {"s3:prefix": ["warehouse/*"]}}
    },
    {
      "Sid": "ReadWriteIcebergMetadataAndData",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject", "s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::${S3_BUCKET}/warehouse/*"
    }
  ]
}
